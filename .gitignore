# ---- Secrets & local config ----
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
# Never commit a Flywheel config — it holds your GitHub token and other secrets.
config.toml
auth.json
.credentials.json

# ---- Flywheel runtime data ----
# Flywheel stores config, the run ledger and workspaces under ~/.flywheel by
# default. Ignore them if FLYWHEEL_HOME is ever pointed inside the repo.
.flywheel/
.factory/
flywheel.db
factory.db
*.db-wal
*.db-shm
workspaces/
run-*/
scratchpad/

# ---- Node / frontend (templates and any local installs) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.turbo/
*.tsbuildinfo

# ---- Playwright ----
playwright-report/
test-results/
/playwright/.cache/

