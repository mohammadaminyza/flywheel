Screen {
    background: $surface;
}

#wizard-body {
    height: 1fr;
    padding: 1 2;
}

#step-panel {
    border: round $primary;
    padding: 1 2;
    height: 1fr;
}

#step-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#step-help {
    color: $text-muted;
    margin-bottom: 1;
}

.field-label {
    margin-top: 1;
    text-style: bold;
}

.hint {
    color: $text-muted;
}

#stepper {
    width: 28;
    border: round $panel;
    padding: 1 2;
    margin-right: 1;
}

.step-done {
    color: $success;
}

.step-active {
    color: $accent;
    text-style: bold;
}

.step-todo {
    color: $text-muted;
}

#wizard-buttons {
    height: auto;
    align: right middle;
    padding: 1 2;
}

#wizard-buttons Button {
    margin-left: 2;
}

#probe-output {
    height: auto;
    max-height: 14;
    border: round $panel;
    padding: 0 1;
    margin-top: 1;
}

.ok {
    color: $success;
}

.bad {
    color: $error;
}

.warn {
    color: $warning;
}

#board-columns {
    height: 1fr;
}

.board-column {
    border: round $panel;
    width: 1fr;
    padding: 0 1;
    margin: 0 1;
}

.column-title {
    text-style: bold;
    color: $accent;
    border-bottom: solid $panel;
}

#status-bar {
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

#question-detail {
    width: 2fr;
}

#question-body {
    height: 1fr;
    padding: 1 1;
}

#answer-box {
    height: 8;
    margin: 1 0;
}

#question-list Button {
    width: 100%;
    margin-bottom: 1;
}
